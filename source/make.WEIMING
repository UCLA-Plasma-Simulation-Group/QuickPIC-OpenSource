# name of the compiler 
JSON_LIB = /usr/local/jsonfortran-gnu-8.3.0/lib/
JSON_INC = /usr/local/jsonfortran-gnu-8.3.0/lib/

FC_WEIMING = mpif90 -c -I$(JSON_INC) -fopenmp
CC_WEIMING = mpicc -c -O3 -std=c99
LINKER_WEIMING = mpif90 -fopenmp -O3

OPTS_DBL_WEIMING = -O3 -fdefault-real-8 -fdefault-double-8
OPTS_SGL_WEIMING = -O3

FORMAT_FREE_WEIMING = -ffree-form 
FORMAT_FIXED_WEIMING = -ffixed-form -fallow-argument-mismatch

# hdf5 libraries 

HDF5_LIB =/Users/anweiming/work/codes/hdf5-1.14.4-3/hdf5/lib
HDF5_INC =/Users/anweiming/work/codes/hdf5-1.14.4-3/hdf5/include

HDF_LIBPATH_WEIMING= -L$(HDF5_LIB) -lhdf5_fortran -lhdf5_hl -lhdf5 -lz 
HDF_INCLUDE_PATH_WEIMING= -I$(HDF5_INC) -I${HDF5_LIB} -lhdf5hl_fortran -lhdf5_fortran -lhdf5_hl -lhdf5
HYPRE_LIB = /Users/anweiming/work/codes/hypre-2.26.0/src/hypre/lib


# other libs
OTHER_LIBS_WEIMING = -L$(JSON_LIB) -ljsonfortran -L$(HYPRE_LIB) -lHYPRE

# memory options
MEM_OPTIONS_WEIMING = 

# options for linking
# use static libs
STATIC_LINK_WEIMING = 
# use shared libs
SHARED_LINK_WEIMING = 
